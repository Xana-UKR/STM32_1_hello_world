{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32",
            "type": "probe-rs-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "probe-rs",
            "chip": "STM32F439ZI",
            "flashingConfig": {
                "flashingEnabled": true,
                "restoreUnwrittenBytes": true,
                "haltAfterReset": true
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/stm32_1_hello_world"
                }
            ]
        }
    ]
}